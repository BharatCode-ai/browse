{
  "manifest_version": 3,
  "name": "BharatCode Browse",
  "description": "Connect your browser to BharatCode Desktop so your agent can work in tabs you share.",
  "version": "0.0.14",
  "minimum_chrome_version": "125",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BharatCode Browse \u00b7 Click to share this tab with your agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "offscreen",
    "tabCapture",
    "webNavigation",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
